{
    "C main": {
        "prefix": "main",
        "description": "C main function with argc/argv",
        "body": [
            "int main(int argc, char *argv[]) {",
            "\t$0",
            "\treturn 0;",
            "}"
        ]
    },
    "C main simple": {
        "prefix": "mains",
        "description": "Simple C main function with no arguments",
        "body": [
            "int main(void) {",
            "\t$0",
            "\treturn 0;",
            "}"
        ]
    },
    "include header": {
        "prefix": "include",
        "description": "Include a C header (angle brackets)",
        "body": [
            "#include <$0>"
        ]
    },
    "include system header": {
        "prefix": "incs",
        "description": "Include a system C header with placeholder",
        "body": [
            "#include <${1:stdio.h}>$0"
        ]
    },
    "include local header": {
        "prefix": "incl",
        "description": "Include a local C header",
        "body": [
            "#include \"${1:header.h}\"$0"
        ]
    },
    "C header guard": {
        "prefix": "guard",
        "description": "C header include guard",
        "body": [
            "#ifndef ${1:HEADER_H}",
            "#define ${1:HEADER_H}",
            "",
            "$0",
            "",
            "#endif /* ${1:HEADER_H} */"
        ]
    },
    "pragma once": {
        "prefix": "once",
        "description": "#pragma once header guard",
        "body": [
            "#pragma once",
            "",
            "$0"
        ]
    },
    "#define constant": {
        "prefix": "def",
        "description": "Define a preprocessor constant",
        "body": [
            "#define ${1:NAME} ${2:value}$0"
        ]
    },
    "#define macro": {
        "prefix": "defm",
        "description": "Define a function-like macro",
        "body": [
            "#define ${1:NAME}(${2:args}) (${3:body})$0"
        ]
    },
    "#ifdef block": {
        "prefix": "ifdef",
        "description": "#ifdef conditional compilation block",
        "body": [
            "#ifdef ${1:MACRO}",
            "$0",
            "#endif /* ${1:MACRO} */"
        ]
    },
    "ARRAY_SIZE macro": {
        "prefix": "arrsize",
        "description": "Macro to count elements in a fixed-size array",
        "body": [
            "#define ARRAY_SIZE(arr) (sizeof(arr) / sizeof((arr)[0]))"
        ]
    },
    "MIN MAX macros": {
        "prefix": "minmax",
        "description": "Define MIN and MAX macros",
        "body": [
            "#define MIN(a, b) ((a) < (b) ? (a) : (b))",
            "#define MAX(a, b) ((a) > (b) ? (a) : (b))"
        ]
    },
    "if": {
        "prefix": "if",
        "description": "if statement",
        "body": [
            "if (${1:condition}) {",
            "\t$0",
            "}"
        ]
    },
    "if else": {
        "prefix": "ifelse",
        "description": "if-else block",
        "body": [
            "if (${1:condition}) {",
            "\t$2",
            "} else {",
            "\t$3",
            "}",
            "$0"
        ]
    },
    "indexed for loop": {
        "prefix": "for",
        "description": "Indexed for loop",
        "body": [
            "for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {",
            "\t$0",
            "}"
        ]
    },
    "reverse for loop": {
        "prefix": "forr",
        "description": "Reverse indexed for loop",
        "body": [
            "for (int ${1:i} = ${2:n} - 1; ${1:i} >= 0; ${1:i}--) {",
            "\t$0",
            "}"
        ]
    },
    "while loop": {
        "prefix": "while",
        "description": "while loop",
        "body": [
            "while (${1:condition}) {",
            "\t$0",
            "}"
        ]
    },
    "do while loop": {
        "prefix": "dowhile",
        "description": "do-while loop",
        "body": [
            "do {",
            "\t$1",
            "} while (${2:condition});",
            "$0"
        ]
    },
    "switch": {
        "prefix": "switch",
        "description": "switch statement",
        "body": [
            "switch (${1:expr}) {",
            "case ${2:value}:",
            "\t$0",
            "\tbreak;",
            "default:",
            "\tbreak;",
            "}"
        ]
    },
    "switch case": {
        "prefix": "case",
        "description": "switch case with break",
        "body": [
            "case ${1:value}:",
            "\t$0",
            "\tbreak;"
        ]
    },
    "C function": {
        "prefix": "fn",
        "description": "C function definition",
        "body": [
            "${1:void} ${2:name}(${3:void}) {",
            "\t$0",
            "}"
        ]
    },
    "static function": {
        "prefix": "sfn",
        "description": "Static C function definition",
        "body": [
            "static ${1:void} ${2:name}(${3:void}) {",
            "\t$0",
            "}"
        ]
    },
    "function prototype": {
        "prefix": "proto",
        "description": "C function prototype declaration",
        "body": [
            "${1:void} ${2:name}(${3:void});$0"
        ]
    },
    "function pointer typedef": {
        "prefix": "fnptr",
        "description": "typedef for a function pointer type",
        "body": [
            "typedef ${1:void} (*${2:fn_t})(${3:void});$0"
        ]
    },
    "typedef struct": {
        "prefix": "struct",
        "description": "typedef struct definition",
        "body": [
            "typedef struct ${1:name} {",
            "\t$2",
            "} ${1:name}_t;",
            "$0"
        ]
    },
    "typedef enum": {
        "prefix": "enum",
        "description": "typedef enum definition",
        "body": [
            "typedef enum {",
            "\t${1:VALUE}",
            "} ${2:name}_t;",
            "$0"
        ]
    },
    "typedef union": {
        "prefix": "union",
        "description": "typedef union definition",
        "body": [
            "typedef union {",
            "\t$1",
            "} ${2:name}_t;",
            "$0"
        ]
    },
    "malloc": {
        "prefix": "malloc",
        "description": "Allocate memory with malloc and NULL check",
        "body": [
            "${1:type} *${2:ptr} = malloc(sizeof(${1:type}) * ${3:count});",
            "if (${2:ptr} == NULL) {",
            "\t${4:return -1;}",
            "}",
            "$0",
            "free(${2:ptr});"
        ]
    },
    "calloc": {
        "prefix": "calloc",
        "description": "Allocate zero-initialized memory with calloc and NULL check",
        "body": [
            "${1:type} *${2:ptr} = calloc(${3:count}, sizeof(${1:type}));",
            "if (${2:ptr} == NULL) {",
            "\t${4:return -1;}",
            "}",
            "$0",
            "free(${2:ptr});"
        ]
    },
    "realloc": {
        "prefix": "realloc",
        "description": "Safely reallocate memory (avoids leak on failure)",
        "body": [
            "${1:type} *${2:tmp} = realloc(${3:ptr}, sizeof(${1:type}) * ${4:count});",
            "if (${2:tmp} == NULL) {",
            "\t${5:return -1;}",
            "}",
            "${3:ptr} = ${2:tmp};",
            "$0"
        ]
    },
    "memset": {
        "prefix": "memset",
        "description": "Fill memory with a constant byte (requires <string.h>)",
        "body": [
            "memset(${1:ptr}, ${2:0}, ${3:size});$0"
        ]
    },
    "memcpy": {
        "prefix": "memcpy",
        "description": "Copy a memory region (requires <string.h>)",
        "body": [
            "memcpy(${1:dest}, ${2:src}, ${3:size});$0"
        ]
    },
    "printf": {
        "prefix": "printf",
        "description": "Print formatted output to stdout",
        "body": [
            "printf(\"${1:%s}\\n\"${2:, args});$0"
        ]
    },
    "fprintf stderr": {
        "prefix": "eprintf",
        "description": "Print formatted error message to stderr",
        "body": [
            "fprintf(stderr, \"${1:error: %s}\\n\"${2:, args});$0"
        ]
    },
    "scanf": {
        "prefix": "scanf",
        "description": "Read formatted input from stdin",
        "body": [
            "scanf(\"${1:%d}\", &${2:var});$0"
        ]
    },
    "snprintf": {
        "prefix": "snprintf",
        "description": "Format string into a buffer with size limit",
        "body": [
            "snprintf(${1:buf}, sizeof(${1:buf}), \"${2:%s}\"${3:, args});$0"
        ]
    },
    "perror": {
        "prefix": "perror",
        "description": "Print a system error message based on errno",
        "body": [
            "perror(\"${1:error}\");$0"
        ]
    },
    "fopen fclose": {
        "prefix": "fopen",
        "description": "Open and close a file with NULL check",
        "body": [
            "FILE *${1:fp} = fopen(\"${2:filename}\", \"${3:r}\");",
            "if (${1:fp} == NULL) {",
            "\tperror(\"fopen\");",
            "\t${4:return -1;}",
            "}",
            "$0",
            "fclose(${1:fp});"
        ]
    },
    "NULL check": {
        "prefix": "nullchk",
        "description": "Check a pointer for NULL and handle the error",
        "body": [
            "if (${1:ptr} == NULL) {",
            "\t${2:return -1;}",
            "}",
            "$0"
        ]
    },
    "assert": {
        "prefix": "assert",
        "description": "Assert a condition (requires <assert.h>)",
        "body": [
            "assert(${1:condition});$0"
        ]
    },
    "goto error handling": {
        "prefix": "goto",
        "description": "goto-based cleanup/error handling pattern",
        "body": [
            "if (${1:condition}) {",
            "\tgoto ${2:err};",
            "}",
            "$0",
            "",
            "${2:err}:",
            "\t${3:/* cleanup */}"
        ]
    },
    "strtol": {
        "prefix": "strtol",
        "description": "Convert string to long integer with error checking",
        "body": [
            "char *${3:endptr};",
            "long ${2:val} = strtol(${1:str}, &${3:endptr}, ${4:10});",
            "if (${3:endptr} == ${1:str} || *${3:endptr} != '\\0') {",
            "\t$0",
            "}"
        ]
    }
}
